cabal-version:       2.0
name:                standard
version:             1.0.0
synopsis:            Literate Haskell semantics for Dhall
description:         The Dhall semantics are written in literate Haskell,
                     meaning that the logical judgments are written side-by-side
                     with the equivalent Haskell code in order to minimize
                     ambiguity.
build-type:          Custom

extra-source-files:    link-literate.sh
                     , syntax.md
                     , alpha-normalization.md
                     , beta-normalization.md
                     , binary.md
                     , equivalence.md
                     , function-check.md
                     , multiline.md
                     , shift.md
                     , substitution.md
                     , type-inference.md
                     , imports-implementation.md
                     , imports-implementation-notes.md
                     , test-server/cert/cert.pem
                     , test-server/cert/key.pem

custom-setup
  setup-depends:       base >= 4.9 && < 5
                     , Cabal
                     , directory
                     , process

library
  build-depends:       base
                     , base16
                     , bytestring
                     , case-insensitive
                     , cborg
                     , containers
                     , cryptonite
                     , directory
                     , filepath
                     , half
                     , http-client
                     , http-client-tls
                     , http-types
                     , connection
                     , megaparsec
                     , memory
                     , parser-combinators
                     , scientific
                     , text
                     , time
  exposed-modules:     AlphaNormalization
                     , BetaNormalization
                     , Binary
                     , Equivalence
                     , FunctionCheck
                     , Imports
                     , Interpret
                     , Multiline
                     , Parser
                     , Syntax
                     , Shift
                     , Substitution
                     , TypeInference
  hs-source-dirs:      ./.
  default-language:    Haskell2010
  default-extensions:  BlockArguments
                     , GeneralizedNewtypeDeriving
                     , OverloadedStrings
                     , TypeFamilies
                     , TypeOperators
  build-tool-depends:  markdown-unlit:markdown-unlit
  ghc-options:         -pgmL markdown-unlit -Wall -Werror

executable dhall
  build-depends:       base, standard
  main-is:             Main.hs
  hs-source-dirs:      dhall
  default-language:    Haskell2010
  ghc-options:         -Wall -Werror

test-suite tasty
  type:                exitcode-stdio-1.0
  main-is:             Main.hs
  other-modules:       TestServer
  build-depends:       async
                     , base
                     , bytestring
                     , cborg
                     , cryptonite
                     , directory
                     , filepath
                     , http-types
                     , megaparsec
                     , serialise
                     , standard
                     , tasty
                     , tasty-hunit
                     , text
                     , wai
                     , warp
                     , warp-tls
  hs-source-dirs:      tasty
  default-extensions:  OverloadedStrings
  default-language:    Haskell2010
  ghc-options:         -Wall -threaded
